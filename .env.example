# Copia este archivo a .env.local (está en .gitignore) y completa los valores.
#
# ⚠️ Todo lo que empieza por VITE_ termina en el JavaScript público del navegador.
#    Aquí solo van la URL y la PUBLISHABLE key. NUNCA la secret key ni la service_role key.
#
# Supabase en la nube: Dashboard → Project Settings → API Keys
# Supabase local (Docker): salida de `npx supabase status`

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
